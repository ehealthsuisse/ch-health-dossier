<CapabilityStatement xmlns="http://hl7.org/fhir">
    <id value="CH.PIXm.Manager"/>
    <url value="http://fhir.ch/ig/ch-health-dossier/CapabilityStatement/CH.PIXm.Manager" />
    <name value="CH_PIXm_Manager" />
    <title value="PIXm Patient Identifier Cross-reference Manager (server)" />
    <status value="active" />
    <date value="2026-07-15" />
    <publisher value="eHealth Suisse"/>
    <contact>
        <name value="eHealth Suisse"/>
        <telecom>
            <system value="url"/>
            <value value="https://www.e-health-suisse.ch"/>
        </telecom>
    </contact>
    <description value="The Patient Identifier Cross-reference Manager allows a conditional update to revise contact information of an existing patient."/>
    <kind value="requirements" />
    <fhirVersion value="4.0.1" />
    <format value="application/fhir+xml" />
    <format value="application/fhir+json" />
    <rest>
        <mode value="server" />
        <documentation value="Patient Identifier Cross-reference Manager support for [ITI-104]." />
        <security>
            <cors value="false" />
            <description value="TLS SHALL be used together with IUA basic access token" />
        </security>
        <resource>
            <type value="Patient"/>
            <supportedProfile value="http://fhir.ch/ig/ch-health-dossier/StructureDefinition/ch-pixm-patient-feed"/>
            <interaction>
                <code value="update"/>
                <documentation value="conditional update for [ITI-104]"/>
            </interaction>
            <conditionalUpdate value="true"/>
        </resource>
    </rest>
</CapabilityStatement>