<CapabilityStatement xmlns="http://hl7.org/fhir">
    <id value="CH.ATC.PatientAuditRecordService"/>
    <url value="http://fhir.ch/ig/ch-health-dossier/CapabilityStatement/CH.ATC.PatientAuditRecordService"/>
    <name value="CH_ATC_PatientAuditRecordService"/>
    <title value="CH:ATC Patient Audit Record Service (server)"/>
    <status value="active"/>
    <date value="2026-10-22"/>
    <publisher value="eHealth Suisse"/>
    <contact>
        <name value="eHealth Suisse"/>
        <telecom>
            <system value="url"/>
            <value value="https://www.e-health-suisse.ch"/>
        </telecom>
    </contact>
    <description value="Defines the CapabilityStatement for the Patient Audit Record Service actor of ITI-81."/>
    <kind value="requirements"/>
    <fhirVersion value="4.0.1"/>
    <format value="application/fhir+xml"/>
    <format value="application/fhir+json"/>
    <rest>
        <mode value="server"/>
        <resource>
            <type value="AuditEvent"/>
            <supportedProfile value="http://fhir.ch/ig/ch-health-dossier/StructureDefinition/ChAuditTrailEvent"/>
            <documentation value="For Retrieve ATNA Audit Event [ITI-81]. The server SHALL support the _sort result parameter on date, in ascending (_sort=date) and descending (_sort=-date) order (CP-ITI-1334)."/>
            <interaction>
                <code value="search-type"/>
                <documentation value="ITI-81: the search parameters are evaluated on the masked audit events"/>
            </interaction>
            <searchParam>
                <name value="date"/>
                <type value="date"/>
            </searchParam>
            <searchParam>
                <name value="agent.identifier"/>
                <type value="token"/>
            </searchParam>
            <searchParam>
                <name value="entity.identifier"/>
                <type value="token"/>
            </searchParam>
            <searchParam>
                <name value="entity-type"/>
                <type value="token"/>
            </searchParam>
            <searchParam>
                <name value="entity-role"/>
                <type value="token"/>
            </searchParam>
            <searchParam>
                <name value="subtype"/>
                <type value="token"/>
            </searchParam>
        </resource>
    </rest>
</CapabilityStatement>