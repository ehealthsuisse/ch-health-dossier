@startuml
skinparam Padding 1
autonumber 1 1 "<b>[00]"
skinparam svgDimensionStyle false

actor user as "Healthcare \nProfessional"

box "Healthcare Professional Portal or Primary System" #BFCAD2
  participant app as "App GUI"
  participant docsource as "Document Source\n(MHD)"
  participant AuthorizationClient as "Authorization Client\n(IUA)"
end box

box "Health Dossier Information System" #FFEFDE
	participant mp_AuthorizationServer as "Authorization Server\n(IUA)"
	participant mp_doc_recipient as "Document Recipient\n(MHD)"
end box

box "IdP" #DFF3F7
	participant idp_user_authentication_provider as "User \nAuthentication \nProvider"
end box

' Sequence starts
user -[#black]> app: write doc
activate app

' Get metadata
app -> mp_AuthorizationServer: GET /.well-known/oauth-authorization-server
activate mp_AuthorizationServer
app <- mp_AuthorizationServer: Authorization Server metadata
deactivate mp_AuthorizationServer


' Get Access Token (Extended)
app -[#black]> AuthorizationClient: Get Access Token
activate AuthorizationClient
AuthorizationClient -> mp_AuthorizationServer: [ITI-71] Get Access Token\n[Extended access token]
activate mp_AuthorizationServer
AuthorizationClient <- mp_AuthorizationServer: [ITI-71] Get Access Token Response\n[Extended access token]
deactivate mp_AuthorizationServer
app <[#black]- AuthorizationClient:
deactivate AuthorizationClient

' Publish Documents
app -> docsource: publish document\nwith extended access token
activate docsource
docsource -[#black]> mp_doc_recipient: publish document [ITI-65] with extended access token
activate mp_doc_recipient
docsource <[#black]- mp_doc_recipient
deactivate mp_doc_recipient
docsource <- app
deactivate docsource

user <[#black]- app
deactivate app

@enduml
